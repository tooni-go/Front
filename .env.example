# ==========================================
# EvalIA Frontend - Environment Variables Template
# ==========================================

# 1. API Keys (IA)
# Clave de API de Google Gemini para procesamiento de texto/PDF
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. URLs de Configuración
# La URL de acceso público del frontend (Next.js)
APP_URL="http://localhost:3001"

# URL base pública del Backend API (NestJS)
# Local local: http://localhost:3000
# Docker: http://localhost:3000 (Mapeado a través del docker-compose)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# 3. Autenticación (NextAuth.js & Google OAuth)
# Credenciales del proyecto en Google Cloud Console para Login
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Clave secreta para firmar las cookies de sesión (generar con: openssl rand -base64 32)
NEXTAUTH_SECRET="YOUR_NEXTAUTH_SECRET"

# URL base para los callbacks de NextAuth (debe coincidir con la URL del Frontend)
NEXTAUTH_URL="http://localhost:3001"
