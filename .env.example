# ==========================================
# EvalIA Frontend - Environment Variables Template
# ==========================================

# 1. API Backend (NestJS)
# URL base de la API del Backend NestJS
# Local: http://localhost:3000 (o http://localhost:3000/api/v1 según endpoints)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# 2. Autenticación (NextAuth.js & Google OAuth)
# Client ID de Google OAuth 2.0 (el mismo de Google Cloud Console)
GOOGLE_CLIENT_ID="tu_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu_google_client_secret"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="tu_google_client_id.apps.googleusercontent.com"

# Clave secreta para firmar las cookies de sesión (generar con: openssl rand -base64 32)
NEXTAUTH_SECRET="tu_nextauth_secret_generado"

# URL base para los callbacks de NextAuth (debe coincidir con la URL del Frontend)
NEXTAUTH_URL="http://localhost:3001"

# 3. URLs y Claves de Servicio
# La URL de acceso público del frontend (Next.js)
APP_URL="http://localhost:3001"

# Clave de API de Google Gemini para procesamiento de IA
GEMINI_API_KEY="tu_gemini_api_key"
